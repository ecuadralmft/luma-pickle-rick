{
  "mcpServers": {
    "luma-remote": {
      "url": "https://ai-mcp.lumafintech.com/mcp",
      "headers": {
        "Accept": "application/json, text/event-stream"
      }
    },
    "memory": {
      "command": "luma",
      "args": [
        "mcp",
        "memory"
      ],
      "env": {
        "MEMORY_BACKENDS": "file,sqlite"
      }
    },
    "gitpulse": {
      "command": "luma",
      "args": [
        "mcp",
        "gitpulse"
      ],
      "env": {}
    },
    "web": {
      "command": "luma",
      "args": [
        "mcp",
        "web"
      ],
      "env": {
        "WEB_SEARCH_BACKEND": "ddg"
      }
    },
    "obsidian": {
      "command": "luma",
      "args": [
        "mcp",
        "obsidian"
      ],
      "env": {
        "MEMORY_ROOT": "/Users/edgardcuadra/luma-memory"
      }
    },
    "jira": {
      "command": "luma",
      "args": [
        "mcp",
        "jira"
      ],
      "env": {
        "JIRA_DOMAIN": "navianexchange.atlassian.net",
        "JIRA_EMAIL": "ecuadra@lumafintech.com",
        "JIRA_TOKEN": "YOUR_JIRA_TOKEN_HERE"
      }
    },
    "pb-ticket": {
      "command": "luma",
      "args": [
        "mcp",
        "pb-ticket"
      ],
      "env": {
        "JIRA_DOMAIN": "navianexchange.atlassian.net",
        "JIRA_EMAIL": "ecuadra@lumafintech.com",
        "JIRA_TOKEN": "YOUR_JIRA_TOKEN_HERE"
      }
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_TOKEN_HERE"
      }
    },
    "slack": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "env": {
        "SLACK_TEAM_ID": "TCJMWUK8F",
        "SLACK_BOT_TOKEN": "xoxb-REPLACE-WITH-YOUR-BOT-TOKEN"
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {}
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {}
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {}
    }
  }
}